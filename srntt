def load_users() -> dict:
    if os.path.exists(USERS_FILE):
        with open(USERS_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    return {}


def save_users(data: dict):
    with open(USERS_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)


def format_static_image(image_bytes: bytes) -> bytes:
    """Конвертирует картинку в статичный WEBP 512x512."""
    with Image.open(io.BytesIO(image_bytes)) as img:
        img = img.convert("RGBA")
        width, height = img.size
        if width > height:
            new_width, new_height = 512, max(1, int(512 * (height / width)))
        else:
            new_height, new_width = 512, max(1, int(512 * (width / height)))
        img = img.resize((new_width, new_height), Image.Resampling.LANCZOS)
        output = io.BytesIO()
        img.save(output, format="WEBP", quality=95)
        return output.getvalue()


async def convert_to_webm(input_bytes: bytes) -> bytes:
    """Конвертирует GIF/MP4 в видео-стикер Telegram (.webm, VP9)."""
    with tempfile.TemporaryDirectory() as tmpdir:
        in_path = os.path.join(tmpdir, "input_media")
        out_path = os.path.join(tmpdir, "output.webm")

        with open(in_path, "wb") as f:
            f.write(input_bytes)

        cmd = [
            "ffmpeg", "-y", "-i", in_path,
            "-t", "00:00:02.9",
            "-an",
            "-vf", "scale=512:512:force_original_aspect_ratio=decrease,fps=30",
            "-c:v", "libvpx-vp9",
            "-b:v", "180k",
            "-maxrate", "220k",
            "-bufsize", "220k",
            "-pix_fmt", "yuva420p",
            "-auto-alt-ref", "0",
            out_path
        ]

        process = await asyncio.create_subprocess_exec(
            *cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE
        )
        _, stderr = await process.communicate()

        if process.returncode != 0 or not os.path.exists(out_path):
            raise RuntimeError(f"Ошибка FFmpeg: {stderr.decode(errors='ignore')[-300:]}")

        with open(out_path, "rb") as f:
            return f.read()


def download_tiktok_no_watermark(url: str, cookies_path: str = None) -> bytes:
    """
    Скачивает видео из TikTok БЕЗ водяного знака (через yt-dlp + резервный API TikWM).
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        out_tmpl = os.path.join(tmpdir, "video.%(ext)s")
        ydl_opts = {
            "outtmpl": out_tmpl,
            # Приоритет потокам без водяного знака (download_addr)
            "format": "bytevc1/h264/mp4/best",
            "quiet": True,
        }
        if cookies_path and os.path.exists(cookies_path):
            ydl_opts["cookiefile"] = cookies_path

        try:
            with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                ydl.download([url])
            for file in os.listdir(tmpdir):
                file_path = os.path.join(tmpdir, file)
                with open(file_path, "rb") as f:
                    return f.read()
        except Exception as e:
            logging.warning(f"yt-dlp не справился ({e}), пробуем резервный метод...")

    raise ValueError("Не удалось скачать видео по ссылке.")


async def download_tiktok_fallback(url: str, cookies_path: str = None) -> bytes:
    """Стабильное скачивание видео из TikTok без водяного знака через публичные шлюзы."""
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        "Referer": "https://www.tiktok.com/"
    }
    
    async with aiohttp.ClientSession(headers=headers) as session:
        # Способ 1: Через официальный публичный API TikWM
        try:
            api_url = "https://www.tikwm.com/api/"
            async with session.post(api_url, data={"url": url, "hd": 1}, timeout=20) as resp:
                data = await resp.json()
                if data.get("code") == 0 and data.get("data", {}):
                    # Берем HD версию без водяного знака
                    video_url = data["data"].get("hdplay") or data["data"].get("play")
                    if video_url:
                        async with session.get(video_url, timeout=30) as v_resp:
                            if v_resp.status == 200:
                                return await v_resp.read()
        except Exception:
            pass

        # Способ 2: Резервный шлюз SnapTik API
        try:
            alt_api = f"https://tikwm.com/api/?url={url}"
            async with session.get(alt_api, timeout=20) as resp:
                data = await resp.json()
                video_url = data.get("data", {}).get("play")
                if video_url:
                    async with session.get(video_url, timeout=30) as v_resp:
                        if v_resp.status == 200:
                            return await v_resp.read()
        except Exception:
            pass

    raise ValueError("TikTok временно заблокировал этот запрос. Попробуйте отправить другую ссылку.")

def fetch_user_favorites(username: str, count: int = 3, cookies_path: str = None) -> list[str]:
    """Получает ссылки на последние избранные/понравившиеся видео из профиля TikTok."""
    clean_user = username.lstrip("@").strip()
    profile_url = f"https://www.tiktok.com/@{clean_user}"
    ydl_opts = {
        "extract_flat": True,
        "playlistend": count,
        "quiet": True,
    }
    if cookies_path and os.path.exists(cookies_path):
        ydl_opts["cookiefile"] = cookies_path

    with yt_dlp.YoutubeDL(ydl_opts) as ydl:
        info = ydl.extract_info(profile_url, download=False)
        entries = info.get("entries") or []
        return [entry.get("url") or entry.get("webpage_url") for entry in entries if entry]


async def add_to_user_pack(user_id: int, file_bytes: bytes, sticker_format: str = "static", emoji: str = "🔥") -> str:
    bot_info = await bot.get_me()
    pack_name = f"tiktok_{user_id}_by_{bot_info.username}"
    pack_title = "SRNTT TikTok Stickers"

    ext = "webm" if sticker_format == "video" else "webp"
    input_file = BufferedInputFile(file_bytes, filename=f"sticker.{ext}")

    sticker = InputSticker(
        sticker=input_file,
        format=sticker_format,
        emoji_list=[emoji]
    )

    try:
        await bot.get_sticker_set(name=pack_name)
        await bot.add_sticker_to_set(user_id=user_id, name=pack_name, sticker=sticker)
    except TelegramBadRequest:
        await bot.create_new_sticker_set(
            user_id=user_id,
            name=pack_name,
            title=pack_title,
            stickers=[sticker]
        )

    return pack_name


