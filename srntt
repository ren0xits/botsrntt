    url = message.text.strip()

    # Если это ссылка на TikTok — предлагаем выбор кнопками!
    if "tiktok.com" in url:
        cache_id = f"{message.from_user.id}_{message.message_id}"
        URL_CACHE[cache_id] = url

        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="📥 Скачать видео (без водяного знака)", callback_data=f"tt_dl:{cache_id}")],
            [InlineKeyboardButton(text="✨ Сделать видео-стикер в пак", callback_data=f"tt_st:{cache_id}")]
