@dp.callback_query(F.data.startswith("tt_"))
async def handle_tiktok_callback(call: CallbackQuery):
    action, cache_id = call.data.split(":", 1)
    url = URL_CACHE.get(cache_id)

    if not url:
        await call.answer("⚠️ Ссылка устарела, отправь её ещё раз!", show_alert=True)
        return

    await call.answer()
    uid = str(call.from_user.id)
    cookies_path = load_users().get(uid, {}).get("cookies")

    if action == "tt_dl":
        await call.message.edit_text("📥 Скачиваю видео из TikTok без водяного знака...")
        try:
            video_bytes = await download_tiktok_fallback(url, cookies_path)
            video_file = BufferedInputFile(video_bytes, filename="tiktok_srntt.mp4")
            await call.message.answer_video(
                video=video_file,
                caption="🎬 Скачано без водяного знака через <b>SRNTT</b>",
                parse_mode="HTML"
            )
            await call.message.delete()
        except Exception as e:
            await call.message.edit_text(f"❌ Не удалось скачать видео: {e}")

    elif action == "tt_st":
        await call.message.edit_text("✨ Скачиваю и конвертирую в видео-стикер (3–5 сек)...")
        try:
            video_bytes = await download_tiktok_fallback(url, cookies_path)
            webm_bytes = await convert_to_webm(video_bytes)
            pack_name = await add_to_user_pack(call.from_user.id, webm_bytes, "video")
            await call.message.edit_text(
                f"✅ Видео-стикер успешно добавлен!\n👉 <a href='https://t.me/addstickers/{pack_name}'>Открыть стикерпак</a>",
                parse_mode="HTML"
            )
        except Exception as e:
            await call.message.edit_text(f"❌ Ошибка создания стикера: {e}")


